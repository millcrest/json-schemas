{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "bands": {
            "title": "Band Types",
            "description": "Ordered list of bands in raster",
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "vrt_file": {
            "title": "VRT filename",
            "description": "VRT file location",
            "type": "string",
            "examples": [
                ".vrt"
            ],
            "format": "uri-reference"
        },
        "raster_file": {
            "title": "Raster filename",
            "description": "Raster file location",
            "type": "string",
            "examples": [
                ".vrt",
                ".tif",
                ".tiff",
                ".icechunk"
            ],
            "format": "uri-reference"
        },
        "raster": {
            "type": "object",
            "properties": {
                "bands": {
                    "$ref": "#/definitions/bands"
                },
                "raster_file": {
                    "$ref": "#/definitions/raster_file"
                },
                "group": {
                    "title": "Icechunk Group",
                    "description": "Capture group in the icechunk repository",
                    "type": "string"
                },
                "snapshot_id": {
                    "title": "Icechunk Snapshot ID",
                    "description": "Reference to the exact snapshot to use from the icechunk repository",
                    "type": "string"
                }
            },
            "required": [
                "bands",
                "raster_file"
            ]
        },
        "rasters": {
            "title": "Rasters",
            "description": "Raster files for multiple bands representing the same area",
            "type": "array",
            "items": {
                "$ref": "#/definitions/raster"
            }
        },
        "model_config": {
            "title": "Model Config",
            "description": "Model configuration",
            "type": "object",
            "properties": {
                "activation": {
                    "title": "Activation",
                    "description": "Activation function",
                    "type": "string",
                    "default": "softmax2d"
                },
                "encoder_depth": {
                    "title": "Encoder Depth",
                    "description": "Depth of the encoder",
                    "type": "integer",
                    "default": 5
                },
                "encoder_type": {
                    "title": "Encoder Type",
                    "description": "Type of encoder",
                    "type": "string",
                    "default": "timm-res2net101_26w_4s"
                },
                "encoder_weights": {
                    "title": "Encoder Weights",
                    "description": "Encoder weights",
                    "type": "string",
                    "default": "imagenet"
                },
                "model_type": {
                    "title": "Model Type",
                    "description": "Model type",
                    "type": "string",
                    "enum": [
                        "Unet",
                        "UnetPlusPlus",
                        "MAnet",
                        "Linknet",
                        "PAN",
                        "Segformer",
                        "UPerNet",
                        "FPN",
                        "PSPNet",
                        "DeepLabV3",
                        "DeepLabV3Plus"
                    ],
                    "default": "Unet"
                },
                "bands": {
                    "$ref": "#/definitions/bands"
                },
                "optional_bands": {
                    "title": "Optional Band Types",
                    "description": "Optional set of bands in raster",
                    "$ref": "#/definitions/bands"
                },
                "train_mean": {
                    "title": "Train Mean",
                    "description": "Mean for training",
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "train_std": {
                    "title": "Train Std",
                    "description": "Standard deviation for training",
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "preprocess_before_augmentation": {
                    "title": "Preprocess before augmentation",
                    "description": "Preprocess before augmentation",
                    "type": "boolean",
                    "default": true
                },
                "augmented_tile_size": {
                    "title": "Augmented Tile Size",
                    "description": "Tile size of the augmented training tiles.",
                    "type": "integer"
                }
            },
            "required": [
                "bands",
                "encoder_type",
                "encoder_weights",
                "activation",
                "encoder_depth",
                "model_type"
            ]
        },
        "balanced_tiles": {
            "title": "Output Tiles",
            "description": "Output Tiles",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "imagery_file": {
                        "title": "Imagery File",
                        "description": "Imagery File",
                        "type": "string",
                        "examples": [
                            ".npz"
                        ],
                        "format": "uri-reference"
                    },
                    "mask_file": {
                        "title": "Mask File",
                        "description": "Mask File",
                        "type": "string",
                        "examples": [
                            ".npz"
                        ],
                        "format": "uri-reference"
                    },
                    "count": {
                        "title": "Data Balance Count",
                        "description": "Data balance count",
                        "type": "integer"
                    },
                    "bands": {
                        "$ref": "#/definitions/bands"
                    }
                },
                "required": [
                    "imagery_file",
                    "mask_file",
                    "count",
                    "bands"
                ]
            }
        },
        "generation_options": {
            "title": "Generation Options",
            "description": "Generation options",
            "type": "object",
            "properties": {
                "fill_partial_tiles": {
                    "title": "Fill Partial Tiles",
                    "description": "Whether to try to fill partial tiles by shifting backwards at raster edges.",
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "bbox_grid": {
            "title": "BBox Grid",
            "description": "File containing a grid of bounding boxes to process",
            "type": "string",
            "examples": [
                ".fgb"
            ],
            "format": "uri-reference"
        },
        "bbox_index": {
            "title": "BBox Index",
            "description": "Index of the polygon to use from the bounding box grid",
            "type": "integer"
        }
    },
    "type": "object",
    "properties": {}
}
